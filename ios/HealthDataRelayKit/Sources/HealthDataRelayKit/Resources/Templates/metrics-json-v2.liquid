---
name: Metrics JSON v2
description: Metrics, workouts and any other section you turn on, as one JSON document, in the shape many health dashboards read.
format: json
data: [metrics, workouts]
---
{"data":{"metrics":[{% for m in metrics %}{{ m }}{% unless forloop.last %},{% endunless %}{% endfor %}]
{%- if workouts.first %},"workouts":{{ workouts }}{% endif -%}
{%- if symptoms.first %},"symptoms":{{ symptoms }}{% endif -%}
{%- if ecg.first %},"ecg":{{ ecg }}{% endif -%}
{%- if heart_rate_notifications.first %},"heartRateNotifications":{{ heart_rate_notifications }}{% endif -%}
{%- if state_of_mind.first %},"stateOfMind":{{ state_of_mind }}{% endif -%}
{%- if cycle_tracking.first %},"cycleTracking":{{ cycle_tracking }}{% endif -%}
{%- if medications.first %},"medications":{{ medications }}{% endif -%}
}}